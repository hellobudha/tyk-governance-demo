{
  "openapi": "3.0.3",
  "info": {
    "title": "Kestrel Payments API",
    "version": "1.0.0",
    "description": "Takes card payments for charging sessions on the Kestrel Charging network.",
    "contact": {
      "name": "Payments Squad",
      "email": "payments-squad@kestrelcharging.example"
    }
  },
  "servers": [
    {
      "url": "https://api.kestrelcharging.example/payments/"
    }
  ],
  "security": [
    {
      "authToken": []
    }
  ],
  "paths": {
    "/payments": {
      "get": {
        "operationId": "listPayments",
        "summary": "List payments",
        "description": "Returns the most recent charging-session payments for the authenticated driver or fleet account.",
        "responses": {
          "200": {
            "description": "A list of payments",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "operationId": "createPayment",
        "summary": "Create a payment",
        "description": "Authorises a card payment for a charging session using a previously tokenised card.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPayment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment created",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/payments/{paymentId}": {
      "get": {
        "operationId": "getPayment",
        "summary": "Get a payment",
        "description": "Returns a single payment by its identifier.",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "description": "Payment identifier (UUID).",
            "schema": {
              "$ref": "#/components/schemas/PaymentId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The payment",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "authToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    },
    "headers": {
      "X-RateLimit-Limit": {
        "description": "Request limit for the current window.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "Retry-After": {
        "description": "Seconds to wait before retrying.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "schemas": {
      "PaymentId": {
        "type": "string",
        "format": "uuid",
        "maxLength": 36,
        "pattern": "^[0-9a-fA-F-]{36}$"
      },
      "Money": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "maximum": 100000000,
        "description": "Amount in minor units."
      },
      "Currency": {
        "type": "string",
        "maxLength": 3,
        "pattern": "^[A-Z]{3}$"
      },
      "NewPayment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "currency",
          "cardToken"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "cardToken": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^tok_[A-Za-z0-9]{8,60}$"
          }
        }
      },
      "Payment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PaymentId"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "status": {
            "type": "string",
            "enum": [
              "authorised",
              "captured",
              "declined",
              "refunded"
            ],
            "maxLength": 16
          }
        }
      },
      "PaymentList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Payment"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z_]+$"
          },
          "message": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[^<>]*$"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/X-RateLimit-Limit"
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/X-RateLimit-Limit"
          }
        }
      },
      "NotFound": {
        "description": "Payment not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/X-RateLimit-Limit"
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          },
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/X-RateLimit-Limit"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/X-RateLimit-Limit"
          }
        }
      }
    }
  },
  "x-tyk-api-gateway": {
    "info": {
      "id": "kestrel-payments-api",
      "name": "Kestrel Payments API",
      "state": {
        "active": true
      }
    },
    "server": {
      "listenPath": {
        "value": "/payments/",
        "strip": true
      },
      "authentication": {
        "enabled": true,
        "securitySchemes": {
          "authToken": {
            "enabled": true
          }
        }
      }
    },
    "upstream": {
      "url": "http://httpbin/anything/payments",
      "rateLimit": {
        "enabled": true,
        "rate": 100,
        "per": "60s"
      }
    }
  }
}